# ============================================================
#  AI 考研英语一训练系统 · 环境配置
#  复制本文件为 .env 并填写下面的值（.env 不会被提交/分享）
# ============================================================

# ---------- AI 模型（任何 OpenAI 兼容接口都可以）----------
# DeepSeek（推荐，便宜且中文讲解质量好）
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash
AI_API_KEY=

# ⚠️ 2026-10-14 决定：**全部用 flash，成本优先**。
# 站长明确说过「模型都是用 flash 不然每日的消费太贵了」，所以这一项保持 flash，
# 不要因为「想提升英语解析质量」就偷偷换成 pro —— 那会让每日费用上去。
# 英语的长难句解析、外刊/真题分析、作文批改走这一项；留空则复用 AI_MODEL。
#
# 型号必须是**服务商真实提供**的：写错的名字不会报「模型不存在」那么明显，
# 而是到生成时才失败。本站 api.deepseek.com 实测**只有两个**：
#   deepseek-flash    便宜、快、**能读图**        ← 当前全站使用
#   deepseek-v4-pro   更强（文本质量好，实测还更快，但更贵）
# 想试质量就改成 deepseek-v4-pro 并自己承担费用；**不要**写 deepseek-chat /
# deepseek-reasoner —— 那两个在这个接口上不存在（曾因此配错，2026-10-14）。
AI_MODEL_STRONG=deepseek-flash

# 拍照识图（数学/信号错题）单独指定型号，留空则复用 AI_MODEL。
# ⚠️ 这个型号**必须能读图**：实测 deepseek-flash 能读，deepseek-v4-pro 与不存在的
# deepseek-chat 会回「无法读取图片」。所以识图这项**不能**跟着 AI_MODEL_STRONG 走 ——
# 如果哪天把强模型换成了 pro，识图仍然是 flash（下面这行就是为此存在的）。
AI_MODEL_VISION=deepseek-flash

# --- 其他常见服务商示例（三选一，改上面三行即可）---
# 智谱 GLM : AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4     AI_MODEL=glm-4-plus
# 通义千问 : AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   AI_MODEL=qwen-plus
# Kimi     : AI_BASE_URL=https://api.moonshot.cn/v1              AI_MODEL=moonshot-v1-32k
# OpenAI   : AI_BASE_URL=https://api.openai.com/v1               AI_MODEL=gpt-4o-mini
# 本地 Ollama: AI_BASE_URL=http://localhost:11434/v1  AI_MODEL=qwen2.5:14b  AI_API_KEY=ollama

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8848

# ---------- 登录与账号（放到公网前必须处理）----------
# 系统有三种运行状态，按「有没有账号 / 有没有口令」自动判定：
#
#   ① 已有账号  → 打开网站出「账号 + 密码」登录页（推荐；多人用就靠它）
#                 开号两条路：你直接开，或别人上 /register 自己申请再由你批准。
#   ② 无账号，但设了 ACCESS_PASSWORD → 沿用原来的单一口令门（大家共用一份数据）
#   ③ 都没有    → 完全不介入，行为跟以前一模一样（只在自己电脑上用时）
#
# ⚠️ 判定「有没有账号」只看**已批准**的账号：所以第一个自助申请的人
#    不会把系统误判成"已建号"而锁死 /setup —— 他登不进去，你照样能建自己的号。
#
# 放到公网前务必让它落到 ① 或 ②：否则任何拿到网址的人都能看到你的全部学习数据，
# 并且能用你的 API Key 花钱。
#
# 【推荐做法】上线后第一次打开网站，会引导你创建管理员账号（你自己）。
# 之后在「设置 → 用户管理」里给熟人开号，每人一套账号密码，数据各自独立。
#
# 创建首个账号需要一个「初始化码」，来源优先级：
#     SETUP_CODE（下面这个） > ACCESS_PASSWORD > 启动时自动生成
#   自动生成的那个会打印在启动日志里，同时写到 data/setup_code.txt。
#   首个账号建好后初始化码自动失效。
#   ⚠️ 在本机用 127.0.0.1 直连访问时免初始化码，方便你先把号建好。
# SETUP_CODE=

# ---------- 自助注册（可选）----------
# 1（默认）= 开放自助注册：别人打开 /register 可以自己填账号密码申请，
#             但**必须管理员在「设置 → 用户管理」里点「批准」之后才能登录**。
#             登录页底部有「自己申请一个」的入口。
# 0 = 关闭：/register 直接返回 403，只能由管理员在用户管理里开号。
# 想让熟人自己动手申请就留 1；不想让注册网址被人乱试就设 0。
# ALLOW_SELF_REGISTER=1

# ---------- 口令门（备选，不想用账号体系时才设它）----------
# 只有在你**一个账号都不建**的时候才生效：打开网址输一个共用口令，
# 输一次记一年；改口令 = 所有设备立刻掉线。所有人共用同一份数据。
# 建议 10 位以上、不要用生日或手机号。
# ACCESS_PASSWORD=

# ---------- 学习策略 ----------
# 每天几点之后自动准备当天内容（24 小时制）
DAILY_GENERATE_HOUR=6
# 当前备考阶段：基础期 / 强化期 / 冲刺期
STAGE=基础期
# 初始难度基准 1-5（系统会按你的表现自动上下调整）
BASE_DIFFICULTY=3
# 目标考试年份（12 月考试）。真题导入的年份下拉、「最近 3 年别精读」的红线提示
# 都由这一个值推导（最新可精读年份 = 本值 - 1，红线 = 最新 - 2）。
EXAM_TARGET_YEAR=2027

# ---------- 数据 ----------
# 默认放在 data/app.db，可改成绝对路径
# DB_PATH=

# ---------- 生成参数 ----------
AI_TEMPERATURE=0.8
AI_TIMEOUT=240
