# ============================================================
#  AI 考研英语一训练系统 · 服务器生产环境配置
#
#  用法（最省事的做法）：
#      直接把本机那份 .env 复制过来，登录初始化码可以留空（系统会自动生成）。
#      API Key、模型、阶段这些设置照抄即可。
#
#      cp  你本机的 .env   /opt/kaoyan/.env
#      # 想让初始化码由你指定（可选，不设也行）：
#      echo "SETUP_CODE=$(openssl rand -base64 12)" >> /opt/kaoyan/.env
#
#  这个模板是给"从零开始填"的情况准备的。
#
#  ⚠️ 这个文件里有密钥，权限设成 600，且**永远不要提交到任何仓库**：
#      chown kaoyan:kaoyan /opt/kaoyan/.env && chmod 600 /opt/kaoyan/.env
# ============================================================

# ---------- 首个账号的初始化码（挂公网前必须有登录）----------
# 服务器上的系统用「账号 + 密码」登录。第一次打开网站会要你输这个码来创建管理员。
# 留空且也没设 ACCESS_PASSWORD 时，系统会自己随机生成一个：
#   打印在启动日志里（journalctl -u kaoyan），并写到 data/setup_code.txt。
# 想自己指定就填一个强随机串，例如 openssl rand -base64 12 的输出。
# 首个账号建好后它自动失效。
SETUP_CODE=

# ---------- 自助注册（可选）----------
# 1（默认）= 开放：别人打开 /register 可自己申请，需你在「设置 → 用户管理」批准后才生效。
# 0 = 关闭：只能由管理员在用户管理里开号（注册网址会被拒绝）。
# 熟人圈子一般留 1 更方便；担心被陌生人乱试就设 0。
# ALLOW_SELF_REGISTER=1

# ---------- 备选：共用口令（只在你一个账号都不建时才生效）----------
# 打开网址输一个共用口令即可进入；所有设备共用同一份数据。
# 改口令后所有设备需要重新登录（"改密码即踢下线"的效果）。
# ACCESS_PASSWORD=

# ---------- AI 模型 ----------
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=

# 长难句分析、作文批改想用更强的模型就填这里，留空则复用上面的
# AI_MODEL_STRONG=deepseek-reasoner

# ---------- 服务 ----------
# 服务器上只监听本机，外网流量全部走 Caddy/nginx 转发
HOST=127.0.0.1
PORT=8848

# ---------- 学习策略 ----------
# 每天几点之后自动准备当天内容（24 小时制）
# 放到服务器上的最大好处：不用你的电脑开机，早上起来内容已经好了
DAILY_GENERATE_HOUR=6
# 当前备考阶段：基础期 / 强化期 / 冲刺期
STAGE=基础期
# 初始难度基准 1-5
BASE_DIFFICULTY=3

# ---------- 数据 ----------
# 留空则默认用 /opt/kaoyan/data/app.db
# DB_PATH=

# ---------- 生成参数 ----------
AI_TEMPERATURE=0.8
AI_TIMEOUT=240
